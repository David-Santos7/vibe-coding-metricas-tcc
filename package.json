{
  "name": "vibe-coding-metricas-tcc",
  "version": "1.0.0",
  "private": true,
  "description": "CRUD de agendamentos para o Cenário A do experimento de TCC.",
  "main": "src/main/server.js",
  "scripts": {
    "start": "node src/main/server.js",
    "dev": "nodemon src/main/server.js",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-include=\"src/**/*.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test:coverage"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "eslint": "^9.37.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  }
}
